MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/conclave?authSource=AUTH_DB
# Used by the Unreal studio for server-side Amazon Polly generative voices.
AWS_REGION=eu-central-1
UNREAL_STUDIO_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
AWS_PROFILE=conclavia-studio
CONCLAVIA_AWS_PROFILE=conclavia-studio
CONCLAVIA_LOCAL_STUDIO_LIFECYCLE=false
# Optional text-generation provider. It is never used for speech synthesis.
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_data_api_key
LIVEAVATAR_API_KEY="your-liveavatar-api-key"
LIVEAVATAR_PRODUCTION_ENABLED=false
LIVEAVATAR_MAX_SESSION_SECONDS=300
# auto tries 1080p first and falls back to high when the plan rejects it.
LIVEAVATAR_VIDEO_QUALITY=auto

# Optional Unreal/MetaHuman renderer. PLAYER_URL is embedded by the browser;
# CONTROL_URL and SUPERVISOR_URL are server-only. Protect the latter two with
# a private network or an IP allow-list in addition to the bearer token.
UNREAL_STUDIO_PLAYER_URL=http://studio-host.example:8080
# The public control URL normally points to the token-protected supervisor;
# Unreal's internal 8081 control plane stays bound to localhost on the GPU host.
UNREAL_STUDIO_CONTROL_URL=http://studio-host.example:8090
UNREAL_STUDIO_SUPERVISOR_URL=http://studio-host.example:8090
UNREAL_STUDIO_TOKEN=replace_with_a_long_random_token
UNREAL_STUDIO_PROFILE=lipsync58

# Optional production cast overrides. Configure avatar and/or LiveAvatar voice
# ID with the matching sex for each purchased custom slot. Unconfigured seats
# use the curated public LiveAvatar catalog.
# LIVEAVATAR_SEAT_1_AVATAR_ID=
# LIVEAVATAR_SEAT_1_VOICE_ID=
# LIVEAVATAR_SEAT_1_SEX=female
# Repeat with LIVEAVATAR_SEAT_2 through LIVEAVATAR_SEAT_5.
# LIVEAVATAR_MODERATOR_AVATAR_ID=
# LIVEAVATAR_MODERATOR_VOICE_ID=
# LIVEAVATAR_MODERATOR_SEX=male
