MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/conclave?authSource=AUTH_DB
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
LIVEAVATAR_API_KEY="your-liveavatar-api-key"
LIVEAVATAR_PRODUCTION_ENABLED=false
LIVEAVATAR_MAX_SESSION_SECONDS=300

# Optional production cast overrides. Configure ID, voice and sex together for
# each purchased custom LiveAvatar slot. Unconfigured seats use the curated
# public 1080p catalog.
# LIVEAVATAR_SEAT_1_AVATAR_ID=
# LIVEAVATAR_SEAT_1_VOICE_ID=
# LIVEAVATAR_SEAT_1_SEX=female
# Repeat with LIVEAVATAR_SEAT_2 through LIVEAVATAR_SEAT_5.
# LIVEAVATAR_MODERATOR_AVATAR_ID=
# LIVEAVATAR_MODERATOR_VOICE_ID=
# LIVEAVATAR_MODERATOR_SEX=male
